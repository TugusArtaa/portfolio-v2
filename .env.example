# ==========================================
# DATABASE (PostgreSQL / Supabase / Prisma)
# ==========================================
# DATABASE_URL: Session / pooled connection string (port 6543)
# DIRECT_URL: Direct connection string (port 5432)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres"

# ==========================================
# SUPABASE API CONFIG
# ==========================================
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ==========================================
# APP URL & NEXTAUTH CONFIG
# ==========================================
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# ==========================================
# GITHUB OAUTH (Untuk login admin via GitHub)
# ==========================================
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# ==========================================
# GROQ AI (Fitur Chatbot / AI)
# ==========================================
GROQ_API_KEY="your-groq-api-key"

# ==========================================
# EMAIL / SMTP (Fitur Contact Form via Nodemailer)
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
